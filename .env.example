# Discord Bot Credentials
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_app_client_id_here
GUILD_ID=your_discord_server_id_for_testing_here

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://injekta_user:your_secure_password@localhost:5432/injekta_db

# Bot Configuration
DESIGNATED_CHANNEL_ID=your_discord_channel_id_for_reminders
# BOT_OWNER_ID=your_discord_user_id (Optional)
